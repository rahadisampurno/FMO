# URL deployment Google Apps Script Web App (Deploy > New deployment > Web app)
NEXT_PUBLIC_FMO_LEADS_ENDPOINT=https://script.google.com/macros/s/AKfycbxG8rv0SrQhywcIMKFPP8yxHEudP_ibakIHPU5rDBYNwR1FeAKvxRJOvlLJ0A_-j-cH9Q/exec

# Database MySQL Hostinger. Gunakan localhost saat aplikasi dan database berada pada akun hosting yang sama.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_fmo
DB_USER=u000000000_fmo
DB_PASSWORD=database-password

# Kredensial Admin disimpan sebagai environment secret pada deployment.
FMO_ADMIN_USERNAME=zaki@fmo.com
FMO_ADMIN_PASSWORD_HASH=pbkdf2$100000$base64url_salt$base64url_hash
FMO_ADMIN_SESSION_SECRET=random-secret-minimum-32-bytes
